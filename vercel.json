{
  "version": 2,
  "name": "site-premium-tcg",
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "admin.html", "use": "@vercel/static" },
    { "src": "devis.html", "use": "@vercel/static" },
    { "src": "image/**", "use": "@vercel/static" },
    { "src": "api/*.js", "use": "@vercel/node", "config": { "nodeVersion": "18.x" } }
  ],
  "routes": [
    { "src": "/(.*)", "has": [{ "type": "host", "value": "edenprojecttcg.com" }], "dest": "https://www.edenprojecttcg.com/$1", "status": 301 },
    { "src": "/api/stripe-webhook", "dest": "/api/stripe-webhook.js" },
    { "src": "/api/verify-email", "dest": "/api/verify-email.js" },
    { "src": "/api/resend-verify", "dest": "/api/resend-verify.js" },
    { "src": "/api/request-delete", "dest": "/api/request-delete.js" },
    { "src": "/api/confirm-delete", "dest": "/api/confirm-delete.js" },
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    { "src": "/image/(.*)", "dest": "/image/$1" },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/devis", "dest": "/devis.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
